generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────── AUTH (better-auth) ───────────────
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  notes        Note[]
  noteVersions NoteVersion[]
  noteShares   NoteShare[]

  categories   Category[]
  transactions Transaction[]

  folders Folder[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─────────────── NOTES MODULE ───────────────

model Folder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  color    String?  @default("#a855f7")
  icon     String?  @default("Folder")
  parentId String?
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")

  sortOrder  Int     @default(0)
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes Note[]

  @@unique([userId, parentId, name])
  @@index([userId, parentId])
  @@map("note_folders")
}

model Note {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String   @default("Untitled")
  content   Json
  plainText String   @default("") @db.Text
  category  String?  @default("General")
  tags      String[] @default([])
  color     String?  @default("#ffffff")

  isPinned   Boolean @default(false)
  isArchived Boolean @default(false)
  isPublic   Boolean @default(false)
  publicSlug String? @unique
  viewCount  Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  folderId  String?
  folder    Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sortOrder Int     @default(0)

  versions NoteVersion[]
  shares   NoteShare[]

  @@index([userId, folderId, sortOrder])
  @@index([userId, isArchived, updatedAt])
  @@index([userId, isPinned])
  @@index([publicSlug])
  @@map("notes")
}

model NoteVersion {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Json
  title     String
  version   Int
  createdAt DateTime @default(now())

  @@index([noteId, version])
  @@map("note_versions")
}

model NoteShare {
  id      String @id @default(cuid())
  noteId  String
  note    Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  email  String // who it's shared with
  token  String @unique // url-safe random token
  role   String @default("viewer") // viewer | editor (future)
  status String @default("pending") // pending | accepted | revoked

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  acceptedAt DateTime?
  expiresAt  DateTime?

  @@unique([noteId, email])
  @@index([email])
  @@index([token])
  @@map("note_shares")
}

// ─────────────── FINANCE MODULE ───────────────

model Category {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  type     String // "income" | "expense"
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  isCustom   Boolean @default(false)
  isArchived Boolean @default(false)
  color      String? @default("#64748b")
  icon       String? @default("Circle")
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       Transaction[] @relation("CategoryTransactions")
  parentTransactions Transaction[] @relation("ParentCategoryTransactions")

  @@unique([userId, name, parentId])
  @@index([userId, type])
  @@index([userId, type, isArchived])
  @@index([userId, parentId])
  @@map("finance_categories")
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount           Decimal   @db.Decimal(12, 2)
  type             String // "income" | "expense"
  categoryId       String
  category         Category  @relation("CategoryTransactions", fields: [categoryId], references: [id])
  parentCategoryId String?
  parentCategory   Category? @relation("ParentCategoryTransactions", fields: [parentCategoryId], references: [id])

  date          DateTime
  description   String?
  paymentMethod String?  @default("other") // cash | upi | card | netbanking | other

  isRecurring    Boolean @default(false)
  recurrenceRule Json? // { frequency, interval, ... } — logic deferred

  metadata      Json? // custom field values (Approach A: minimal use)
  attachmentUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // prisma/schema.prisma — Transaction model
  @@index([userId, date(sort: Desc)])
  @@index([userId, type, date(sort: Desc)])
  @@index([userId, parentCategoryId, date(sort: Desc)])
  @@index([userId, categoryId, date(sort: Desc)])
  @@map("finance_transactions")
}
